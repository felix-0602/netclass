# Netclass Sidekick — 生产环境变量模板
#
# 部署前把本文件复制为 .env 并填入真实值：
#   cp deploy/.env.example server/.env
#   vi server/.env
#
# 注意：server/.env 已在 .gitignore 里，绝不要 commit

# === 必填 ===

# JWT 签名密钥（32 字符以上随机 hex）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-32plus-hex-chars

# Admin Key（drain worker 用来调 /admin/* 接口）
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=replace-me-with-24plus-hex-chars


# === 可选（有合理默认） ===

# 协议版本（跟客户端 X-Client-Protocol header 对齐）
PROTOCOL_VERSION=1.0.0-alpha

# sqlite 数据库文件路径。建议放在 /var/lib/netclass 下避免 tmp 丢
DB_PATH=/home/ubuntu/netclass/server/netclass.db

# Worker 监听端口（80 需要 root 或 setcap，选 8080 最省事）
PORT=8080

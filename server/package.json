{
  "name": "@netclass/server",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Netclass Sidekick Cloudflare Workers server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply netclass-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply netclass-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "2.1.9",
    "wrangler": "^3.99.0"
  }
}
